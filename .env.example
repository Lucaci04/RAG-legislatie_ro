# Copiază acest fișier în .env și completează cheia.
# Cheie gratuită: https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# Opțional: modelul principal și cel de rezervă, folosit când primul e indisponibil
# sau și-a atins limita zilnică (tier gratuit: 20 de cereri/zi/model).
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
